{
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "cetabaofest.com.br" }], "destination": "https://www.cetabaofest.com.br/:path*", "permanent": true },
    { "source": "/cadastro", "destination": "/", "permanent": false },
    { "source": "/cadastro/:path*", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/pedido/:token", "destination": "/pedido/index.html" }
  ]
}
