{
  "redirects": [
    {
      "source": "/cadastro",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/cadastro/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/cadastro/:path+",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/pedido/:token",
      "destination": "/pedido/index.html"
    }
  ]
}
